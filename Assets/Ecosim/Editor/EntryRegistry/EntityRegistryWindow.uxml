<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement style="padding: 5px;">
        <editor:ObjectField name="DataBaseField" label="DataBase Asset"/>
    </engine:VisualElement>
    <engine:VisualElement style="flex-grow: 1; flex-direction: row; padding-bottom: 5px;">
        <engine:VisualElement name="AllSpecifications" style="width: 230px; min-width: 230px; margin: 2px; border-width: 1px; border-color: rgb(35, 35, 35); border-radius: 4px; background-color: rgb(45, 45, 45); padding: 4px;">
            <engine:Button name="SyncButton" text="Scan &amp; Update Database" style="border-radius: 4px;"/>
            <engine:Button name="CreateButton" text="New Specification" style="background-color: rgba(180, 255, 180, 0.2); border-radius: 4px;"/>
            <engine:ScrollView name="ListSpecification" style="margin-top: 5px; flex-grow: 1;"/>
        </engine:VisualElement>
        <engine:VisualElement name="InfoSpecification" style="flex-grow: 1; margin: 2px; border-width: 1px; border-color: rgb(35, 35, 35); border-radius: 4px; background-color: rgb(45, 45, 45); padding: 4px;">
            <engine:ScrollView name="DetailsContainer" horizontal-scroller-visibility="Hidden" style="flex-grow: 1; display: none;">
                <editor:ObjectField label="Script" name="ScriptField" readonly="true"/>
                <engine:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 2px;">
                    <editor:LongField label="Id" binding-path="_id" readonly="true" picking-mode="Ignore" name="IdField" style="flex-grow: 1;"/>
                    <engine:Button name="CopyIdButton" tooltip="Copy ID" icon-image="project://database/Assets/Ecosim/Editor/EntryRegistry/copy.png?fileID=2800000&amp;guid=aa396dc301afb42a19fcd44a394cee7f&amp;type=3#copy" display-tooltip-when-elided="true" style="width: 25px; height: 27px; background-color: rgba(0, 0, 0, 0); border-width: 0; margin-left: 4px; padding-left: 0; padding-right: 0; margin-top: 4px; margin-right: 4px; margin-bottom: 4px; min-height: auto; padding-bottom: 0; padding-top: 0;"/>
                </engine:VisualElement>
                <engine:TextField label="Name" binding-path="&lt;Name&gt;k__BackingField"/>
                <editor:EnumField label="Type" binding-path="&lt;Type&gt;k__BackingField"/>
                <editor:PropertyField label="Behaviour" binding-path="Behaviour"/>
                <editor:PropertyField binding-path="Configuration"/>
                <engine:Button name="DeleteButton" text="Delete" style="background-color: rgb(132, 44, 44); color: white; margin-top: 20px; height: 28px; border-radius: 4px; -unity-font-style: bold;"/>
            </engine:ScrollView>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
